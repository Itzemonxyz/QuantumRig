{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "savedProductIds": { "type": "array" },
        "loyaltyPoints": { "type": "number" }
      },
      "required": ["name", "email", "role"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      }
    },
    "Brand": {
      "title": "Brand",
      "description": "Product brand",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Product inventory",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "stockStatus": { "type": "string" },
        "inventoryCount": { "type": "number" },
        "imageUrl": { "type": "string" },
        "additionalImages": { "type": "array" },
        "description": { "type": "string" },
        "specs": { "type": "object" },
        "socket": { "type": "string" },
        "wattage": { "type": "number" }
      },
      "required": ["title", "slug", "categoryId", "price", "stockStatus", "imageUrl"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "rating", "comment", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "deliveryDetails": { "type": "object" },
        "trackingHistory": { "type": "array" },
        "couponCode": { "type": "string" },
        "discountAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "items", "totalAmount", "status", "deliveryDetails", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "isActive": { "type": "boolean" },
        "applicableProductIds": { "type": "array" }
      },
      "required": ["code", "discountPercentage", "isActive"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global settings",
      "type": "object",
      "properties": {
        "announcementText": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "whatsappUrl": { "type": "string" },
        "instagramUrl": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Global user profiles"
    },
    "categories": {
      "schema": "Category",
      "description": "Categories catalog"
    },
    "brands": {
      "schema": "Brand",
      "description": "Brands catalog"
    },
    "products": {
      "schema": "Product",
      "description": "Products catalog"
    },
    "products/{productId}/reviews": {
      "schema": "Review",
      "description": "Product reviews"
    },
    "orders": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "coupons": {
      "schema": "Coupon",
      "description": "Discount coupons"
    },
    "settings": {
      "schema": "Settings",
      "description": "Global settings"
    }
  }
}
