rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reusable custom validation predicates
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      // Only the authenticated user can access their own profile.
      // Admin SDK bypasses these rules automatically.
      allow read, write: if isOwner(userId);
    }
    
    // 2. Catalog Collections (Products, Categories, Brands, Reviews)
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
      
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if false;
      }
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /brands/{brandId} {
      allow read: if true;
      allow write: if false;
    }
    
    // 3. Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // Writes should be handled by the backend
    }
    
    // 4. Coupons & Config
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /social_links/{linkId} {
      allow read: if true;
      allow write: if false;
    }
    
    // 5. Customer support and restocks
    match /restocks/{restockId} {
      allow read: if false;
      allow write: if false; // Handled by backend
    }
    
    match /support/{ticketId} {
      allow read: if false;
      allow write: if false; // Handled by backend
    }
    
    match /complaints/{complaintId} {
      allow read: if false;
      allow write: if false; // Handled by backend
    }

    // 6. Triggered Mail/Order Receipts
    match /mail/{mailId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false; // Handled by backend
    }

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
