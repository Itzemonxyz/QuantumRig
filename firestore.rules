rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Allow reading and writing user profiles
    // Note: server.ts updates saved lists and notifications without authentication
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // 2. Allow general read/write access to catalog and shop collections
    // Note: Since server.ts uses the client Web SDK without authentication to sync,
    // it requires open access to sync products, categories, brands, and orders safely.
    match /products/{document=**} { allow read, write: if true; }
    match /categories/{document=**} { allow read, write: if true; }
    match /brands/{document=**} { allow read, write: if true; }
    match /orders/{document=**} { allow read, write: if true; }
    
    // 3. Dynamic Website Config & Information Collections
    // Note: Required for perfect synchronization with server.ts and fast client loading
    match /settings/{document=**} { allow read, write: if true; }
    match /coupons/{document=**} { allow read, write: if true; }
    match /restocks/{document=**} { allow read, write: if true; }
    match /support/{document=**} { allow read, write: if true; }
    match /offers/{document=**} { allow read, write: if true; }
    match /social_links/{document=**} { allow read, write: if true; }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
